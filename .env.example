# All optional — sensible defaults are baked in. Copy to .env for local
# overrides, or set these in docker-compose.yml / your process manager for
# production.

# Max bytes accepted for a single uploaded file (default 45 MB)
MAX_UPLOAD_BYTES=47185920

# Max width*height accepted for a source image — decompression-bomb guard (default ~60MP)
MAX_INPUT_PIXELS=60000000

# Max width/height accepted for requested output (default 8000)
MAX_OUTPUT_DIMENSION=8000

# Max files accepted per batch upload (default 30)
MAX_BATCH_FILES=30

# Per-image processing timeout in ms (default 30000)
PROCESSING_TIMEOUT_MS=30000

# In-memory per-IP rate limit (default: 40 requests / 60s)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=40
